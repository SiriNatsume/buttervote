# Run on the Bot machine; never expose the OneBot endpoint to the public web.
BUTTERVOTE_URL=https://your-site.example
BOT_API_SECRET=replace-with-the-sites-bot-secret
ONEBOT_HTTP_URL=http://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=replace-with-onebot-token
BUTTERVOTE_SYNC_ALLOWED_GROUPS=123456789,987654321
