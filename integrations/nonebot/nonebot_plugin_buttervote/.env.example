# Add these to the existing Bot application's .env / .env.prod.
BUTTERVOTE_URL=https://your-site.example
BOT_API_SECRET=replace-with-the-sites-bot-secret
BUTTERVOTE_SYNC_ALLOWED_GROUPS=[123456789,987654321]
# Or allow any group whose members this Bot can read:
# BUTTERVOTE_SYNC_ALLOWED_GROUPS=all

# Optional; required when several OneBot v11 accounts are connected.
# BUTTERVOTE_SYNC_BOT_ID=123456789
# BUTTERVOTE_SYNC_ENABLED=true
# BUTTERVOTE_SYNC_POLL_SECONDS=5
# BUTTERVOTE_SYNC_TIMEOUT_SECONDS=20
