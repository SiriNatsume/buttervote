# 托管/自定义环境配置。贡献者的本地环境请使用 npm run setup:local，
# 它会在 .local/ 中生成独立配置，不需要填写或共享生产密钥。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
BOT_API_SECRET=
APP_SESSION_COOKIE_NAME=app_session
APP_SESSION_DAYS=30
QQ_LOGIN_TICKET_TTL_MINUTES=5
USER_GROUP_MEMBERSHIP_DAYS=7
NEXT_PUBLIC_SITE_URL=

# 可选：角色搜索默认支持 Bangumi、AniList、VNDB，无需密钥。
# 建议在 User-Agent 中填写站点地址或项目联系方式。
BANGUMI_USER_AGENT=
# 如需使用 Bangumi 账号授权范围内的数据，可配置服务端 token。
BANGUMI_ACCESS_TOKEN=

# Wrangler deploy. Keep real values in .env, not .env.local.
CLOUDFLARE_ACCOUNT_ID=
# Optional if you deploy with an API token instead of wrangler login.
CLOUDFLARE_API_TOKEN=
